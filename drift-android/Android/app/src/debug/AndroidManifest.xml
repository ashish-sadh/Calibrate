<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG-ONLY manifest overlay: lets the e2e test seed a weight record into
     Health Connect so the read pipeline can be verified on the emulator.
     Release builds stay strictly read-only. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <!-- debugSeedExerciseSession() also writes the session's active-calorie
         total so the Health Connect band has a non-zero number to show. -->
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" />
</manifest>
