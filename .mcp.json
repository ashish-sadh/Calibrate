{
  "mcpServers": {
    "drift": {
      "command": "/opt/homebrew/bin/python3.11",
      "args": [
        "-m",
        "drift_mcp.server"
      ],
      "env": {
        "PYTHONPATH": "/Users/ashishsadh/workspace/Drift/drift-mcp",
        "DRIFT_REPO": "/Users/ashishsadh/workspace/Drift"
      }
    },
    "mobile": {
      "command": "npx",
      "args": [
        "-y",
        "@mobilenext/mobile-mcp@latest"
      ]
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching"
    }
  }
}