.DS_Store
*.swp
*~

# Temporary
*.tmp
*.log
*.gguf
*.db
command-center/worker/.wrangler/
*.xcuserstate

# graphify knowledge graph (keep outputs, ignore large temp files)
graphify-out/cache/
graphify-out/.graphify_ast.json
graphify-out/.graphify_extract.json
graphify-out/.graphify_semantic.json
graphify-out/.graphify_cached.json
graphify-out/.graphify_uncached.txt
graphify-out/.graphify_semantic_new.json
graphify-out/.graphify_transcripts.json
graphify-out/graph.html

# Local API keys — never commit
.drift-secrets/
*.anthropic-key
/tmp/drift-test-*

# command-center/heartbeat.json is NOT tracked on main (#758). The
# watchdog pushes it to the `heartbeat-data` side branch via git plumbing,
# so the deployed Command Center can fetch fresh data without polluting
# main's git log. See scripts/self-improve-watchdog.sh:commit_heartbeat_to_branch.
command-center/heartbeat.json

# Python build artifacts (drift-mcp)
__pycache__/
*.pyc
.pytest_cache/


# Local scheduler lock (transient — re-created per wakeup)
.claude/scheduled_tasks.lock
